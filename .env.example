# VoiceBridge AI — Environment Variables Configuration
# Copy this file to .env and fill in your keys.

# ===========================================================================
# LLM Provider Selection
# Options: groq (default) | deepseek | ollama
# ===========================================================================
LLM_PROVIDER=groq

# ---------------------------------------------------------------------------
# 1. Groq Cloud (High-Speed LPU Inference - Free tier recommended)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
# Cascading models: Primary = openai/gpt-oss-120b | Fallback = openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# 2. DeepSeek (Ultra-Low Cost Cloud API - Optional)
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-your_deepseek_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 3. Ollama (100% Local Open-Source - Zero API cost / Offline)
# ---------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
